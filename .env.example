# Mainnet is the default. You do not need this file to start: run
#   python -m agent_kit.scripts.agent init --owner 0x<your wallet>
# and the kit writes .env itself (owner, agent key, agent account).
# Copy this file to .env only to change the deployment or mode.
# Shell variables override this file. Never commit .env or print private keys.

# Explicit mode: live (mainnet), devnet, or read-only (disables writes).
# Use the separate paper command for simulation.
REYA_MODE=live

# Mainnet (default): real funds.
CHAIN_ID=1729
REYA_API_URL=https://api.reya.xyz/v2
REYA_ORDERS_GATEWAY=0xfc8c96be87da63cecddbf54abfa7b13ee8044739
REYA_DEX_ID=2

# Devnet1 (not Cronos): replace all four network settings together and set REYA_MODE=devnet.
# CHAIN_ID=89346162
# REYA_API_URL=https://api-devnet.reya-cronos.network/v2
# REYA_ORDERS_GATEWAY=0x7Ec89E555c771D2B5939aBE5C4E4291852633D4D
# REYA_DEX_ID=1

# Cronos: replace the URL and gateway together; verify its exchange ID.
# CHAIN_ID=89346162
# REYA_API_URL=https://api-cronos.reya.xyz/v2
# REYA_ORDERS_GATEWAY=0x5a0ac2f89e0bdeafc5c549e354842210a3e87ca5
# REYA_DEX_ID=<exchange_id>

# App for the setup deep links: mainnet (https://app.reya.xyz) and devnet1
# (https://app-devnet-cf.reya.xyz) have defaults; set REYA_APP_URL for other deployments.
# REYA_APP_URL=https://<app host for this deployment>

# --- Default signer: the agent key (no owner key involved) ---------------------
# Written by `agent init`: it generates PERP_AGENT_PRIVATE_KEY here, you approve
# PERP_AGENT_ADDRESS once in the Reya app (More -> API), the app creates and funds the
# agent account, and the kit records it below. The agent key trades only PERP_AGENT_ACCOUNT_IDS.
PERP_WALLET_ADDRESS_1=
PERP_ACCOUNT_ID_1=
# PERP_AGENT_PRIVATE_KEY=   (written by agent init; never paste or print)
# PERP_AGENT_ADDRESS=       (written by agent init)
# PERP_AGENT_ACCOUNT_IDS=   (written by agent init)

# --- Alternative: your own key (dedicated wallet) ------------------------------
# Only if you deliberately hand the kit a wallet key, e.g. a fresh wallet created
# for it. Set REYA_SIGNER=own-key and exactly one of the two sources.
# REYA_SIGNER=own-key
# PERP_PRIVATE_KEY_1=
# PERP_PRIVATE_KEY_FILE=/absolute/path/to/signer.key   (owner-only regular file, 0600/0400, no symlinks)

# Optional account setup commands (own-key setups; agent init uses the app instead).
# Creation needs no key. Transfers sign an authorization; Reya relays and pays gas.
# REYA_ACCOUNT_OWNER_KEY_FILE=/absolute/path/to/owner.key

# Order guards (optional). Above either limit an order needs --allow_large, which the
# assistant adds only after you confirm that order. Limit prices more than 5% through the
# mark need --force.
# REYA_MAX_ORDER_NOTIONAL=500   (USDC per order; default: the account's value)
# REYA_MAX_LEVERAGE=5           (estimated leverage after the order; default 5)
# REYA_MARGIN_HEADROOM=0.002    (spare margin --max_size/--usage leave, as a fraction of the
#                                position notional after the fill; default 0.002)

# Hosted workflows (workflow commands). Mainnet and devnet1 have defaults; set these only
# for another service, or REYA_WORKFLOWS_ENVIRONMENT (mainnet, testnet or devnet1) for a custom REYA_API_URL.
# REYA_WORKFLOWS_URL=https://<workflow service for this deployment>
# REYA_WORKFLOWS_ENVIRONMENT=devnet1

# All participating local kit checkouts must use the same owner-only state directory.
# Default: ~/.local/state/reya-agent-kit (no secrets stored in writer state).
# REYA_STATE_DIR=/absolute/path/to/reya-agent-kit-state
