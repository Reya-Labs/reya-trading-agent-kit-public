# Explicit mode: read-only disables writes; use the separate paper command for simulation.
REYA_MODE=live
# Production / mainnet. Copy to .env in a separate mainnet kit checkout.
# Existing shell variables override this file; verify health.api_url first.
CHAIN_ID=1729
REYA_API_URL=https://api.reya.xyz/v2
REYA_ORDERS_GATEWAY=0xfc8c96be87da63cecddbf54abfa7b13ee8044739
REYA_DEX_ID=2

# --- Default signer: the agent key (no owner key involved) ---------------------
# `python -m agent_kit.scripts.agent init --owner 0x<your wallet>` fills these in:
# the kit generates its own key, you approve its address once on https://app.reya.xyz
# (API page), the app creates and funds the agent account, and the kit records it.
# The agent key trades only PERP_AGENT_ACCOUNT_IDS.
PERP_WALLET_ADDRESS_1=
PERP_ACCOUNT_ID_1=
# PERP_AGENT_PRIVATE_KEY=   (written by agent init; never paste or print)
# PERP_AGENT_ADDRESS=       (written by agent init)
# PERP_AGENT_ACCOUNT_IDS=   (written by agent init)

# --- Alternative: your own key (dedicated wallet) ------------------------------
# Only for deliberate live writes with a key you chose to hand to the kit.
# Set REYA_SIGNER=own-key and exactly one source. Keep keys out of examples, logs, source control and chat.
# REYA_SIGNER=own-key
# PERP_PRIVATE_KEY_1=
# PERP_PRIVATE_KEY_FILE=/absolute/path/to/signer.key   (owner-only regular file, 0600/0400, no symlinks)

# Optional account setup commands (own-key setups; agent init uses the app instead).
# Creation needs no key. Transfers sign an authorization; Reya relays and pays gas.
# REYA_ACCOUNT_OWNER_KEY_FILE=/absolute/path/to/owner.key

# Order guards. Limit prices more than 5% through the mark need --force. The kit sets no
# size or leverage limit of its own: Reya's margin check applies each market's maximum
# leverage. To add your own, set either below; above it an order needs --allow_large, which
# the assistant adds only after you confirm that order.
# REYA_MAX_LEVERAGE=5           (estimated leverage after the order, all positions; unset: none)
# REYA_MAX_ORDER_NOTIONAL=500   (USDC per order; unset: none)
# REYA_MARGIN_HEADROOM=0.002    (spare margin --max_size/--usage leave, as a fraction of the
#                                position notional after the fill; default 0.002)

# All participating local kit checkouts must use the same owner-only state directory.
# Default: ~/.local/state/reya-agent-kit (no secrets stored in writer state).
# REYA_STATE_DIR=/absolute/path/to/reya-agent-kit-state
